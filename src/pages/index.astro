---
const branchName = "main";
const buildTime = new Date().toISOString();

const metrics = [
  { label: "Production Latency", value: "14ms", status: "Optimal", color: "#10b981" },
  { label: "Edge Locations", value: "320+", status: "Active", color: "#38bdf8" },
  { label: "Cache Hit Ratio", value: "99.9%", status: "Global", color: "#a855f7" },
  { label: "Features Merged", value: "2", status: "Production", color: "#f97316" }
];

const edgeNodes = [
  { location: "US-East (IAD)", status: "Online", ping: "4ms" },
  { location: "EU-Central (FRA)", status: "Online", ping: "12ms" },
  { location: "AP-East (HKG)", status: "Online", ping: "22ms" },
  { location: "SA-East (GRU)", status: "Online", ping: "35ms" }
];

const chatMessages = [
  { sender: "User", text: "How does Cloudflare Pages handle per-branch preview URLs?", time: "14:48" },
  { sender: "Antigravity AI", text: "Every non-main branch push generates a unique, isolated preview URL automatically!", time: "14:49" },
  { sender: "User", text: "Are all PRs and feature branches merged into Production now?", time: "14:51" },
  { sender: "Antigravity AI", text: "Yes! Both Analytics Dashboard & AI Chat Interface are now merged into main and deployed live to Production!", time: "14:52" }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astro Cloudflare Production | {branchName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="background-glow"></div>
    <main class="container">
      <header class="header">
        <div class="badge prod-badge">
          <span class="pulse-dot"></span>
          <span>Environment: <strong>{branchName} (Production)</strong></span>
        </div>
        <h1>🚀 Combined Production Suite</h1>
        <p class="subtitle">
          All feature branches (<strong>Analytics Dashboard</strong> & <strong>AI Chat Interface</strong>) have been merged and deployed to Production!
        </p>
      </header>

      <!-- FEATURE 1: Analytics & Metrics Grid -->
      <section class="metrics-section">
        <h2 class="section-title">📊 Analytics & Branch Metrics (Merged)</h2>
        <div class="metrics-grid">
          {metrics.map(m => (
            <div class="metric-card">
              <div class="metric-header">
                <span class="metric-label">{m.label}</span>
                <span class="metric-status" style={`background: ${m.color}20; color: ${m.color}; border: 1px solid ${m.color}40`}>
                  {m.status}
                </span>
              </div>
              <div class="metric-value">{m.value}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- FEATURE 1 PART B: Global Edge Nodes -->
      <section class="nodes-section">
        <h2 class="section-title">🌐 Global Edge Nodes</h2>
        <div class="nodes-grid">
          {edgeNodes.map(node => (
            <div class="node-card">
              <div class="node-info">
                <span class="node-dot"></span>
                <span class="node-location">{node.location}</span>
              </div>
              <span class="node-ping">{node.ping}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- FEATURE 2: AI Chat Widget -->
      <section class="chat-section">
        <h2 class="section-title">🤖 AI Copilot Assistant (Merged)</h2>
        <div class="chat-card">
          <div class="chat-header">
            <div class="ai-status">
              <span class="status-indicator"></span>
              <span class="ai-title">Antigravity Copilot AI</span>
              <span class="model-tag">Gemini 2.5 Flash</span>
            </div>
            <span class="chat-badge">Production Feature</span>
          </div>

          <div class="chat-body">
            {chatMessages.map(msg => (
              <div class={`message-wrapper ${msg.sender === 'User' ? 'user-msg' : 'ai-msg'}`}>
                <div class="message-bubble">
                  <div class="msg-sender">{msg.sender}</div>
                  <div class="msg-text">{msg.text}</div>
                  <div class="msg-time">{msg.time}</div>
                </div>
              </div>
            ))}
          </div>

          <div class="chat-footer">
            <input type="text" placeholder="Type a prompt for AI agent..." class="chat-input" readonly />
            <button class="send-btn">Send ✨</button>
          </div>
        </div>
      </section>

      <div class="grid">
        <!-- Card 1: Branch Status -->
        <div class="card highlight-prod">
          <div class="card-icon">🚀</div>
          <h2>Production Status</h2>
          <div class="info-row">
            <span class="label">Environment:</span>
            <span class="value badge-prod">Live Production</span>
          </div>
          <div class="info-row">
            <span class="label">Git Branch:</span>
            <code class="code">{branchName}</code>
          </div>
          <div class="info-row">
            <span class="label">Last Built:</span>
            <span class="value">{buildTime}</span>
          </div>
        </div>

        <!-- Card 2: Workflow Summary -->
        <div class="card">
          <div class="card-icon">✅</div>
          <h2>Workflow Completed</h2>
          <ol class="steps">
            <li>Created <code>feature/analytics-dashboard</code> and verified branch preview.</li>
            <li>Created <code>feature/ai-chat-interface</code> and verified branch preview.</li>
            <li>Both feature PRs merged cleanly into <code>main</code>!</li>
          </ol>
        </div>

        <!-- Card 3: Cloudflare Settings -->
        <div class="card">
          <div class="card-icon">⚙️</div>
          <h2>Cloudflare Pages Config</h2>
          <div class="config-list">
            <div class="config-item">
              <span class="config-name">Framework Preset:</span>
              <span class="config-val">Astro</span>
            </div>
            <div class="config-item">
              <span class="config-name">Build Command:</span>
              <span class="config-val"><code>npm run build</code></span>
            </div>
            <div class="config-item">
              <span class="config-name">Output Directory:</span>
              <span class="config-val"><code>dist</code></span>
            </div>
            <div class="config-item">
              <span class="config-name">Deployment:</span>
              <span class="config-val">Production</span>
            </div>
          </div>
        </div>
      </div>

      <footer class="footer">
        <p>Built with ❤️ for testing GitHub & Cloudflare Pages Branch Previews</p>
      </footer>
    </main>

    <style>
      :root {
        --bg: #090d16;
        --card-bg: rgba(22, 30, 46, 0.75);
        --card-border: rgba(255, 255, 255, 0.08);
        --text: #e2e8f0;
        --text-dim: #94a3b8;
        --accent: #3b82f6;
        --accent-glow: rgba(59, 130, 246, 0.25);
        --prod-color: #10b981;
        --font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow-x: hidden;
      }

      .background-glow {
        position: absolute;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, var(--accent-glow) 0%, rgba(9, 13, 22, 0) 70%);
        top: -200px;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: none;
        z-index: 0;
      }

      .container {
        max-width: 980px;
        width: 100%;
        padding: 3rem 1.5rem;
        position: relative;
        z-index: 1;
      }

      .header {
        text-align: center;
        margin-bottom: 3rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: var(--prod-color);
        padding: 0.4rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
      }

      .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: var(--prod-color);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--prod-color);
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      h1 {
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #ffffff 30%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 1rem;
      }

      .subtitle {
        color: var(--text-dim);
        font-size: 1.125rem;
        max-width: 650px;
        margin: 0 auto;
        line-height: 1.6;
      }

      .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #38bdf8;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .metrics-section, .nodes-section, .chat-section {
        margin-bottom: 3rem;
      }

      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
      }

      .metric-card {
        background: rgba(16, 185, 129, 0.05);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 12px;
        padding: 1.25rem;
        backdrop-filter: blur(8px);
      }

      .metric-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
      }

      .metric-label {
        font-size: 0.85rem;
        color: var(--text-dim);
      }

      .metric-status {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        text-transform: uppercase;
      }

      .metric-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: #ffffff;
      }

      .nodes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 1rem;
      }

      .node-card {
        background: rgba(56, 189, 248, 0.05);
        border: 1px solid rgba(56, 189, 248, 0.2);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .node-info {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .node-dot {
        width: 8px;
        height: 8px;
        background-color: #38bdf8;
        border-radius: 50%;
        box-shadow: 0 0 6px #38bdf8;
      }

      .node-location {
        font-size: 0.9rem;
        font-weight: 600;
      }

      .node-ping {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.15);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
      }

      /* AI CHAT WIDGET */
      .chat-card {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 16px 40px rgba(59, 130, 246, 0.1);
        backdrop-filter: blur(16px);
      }

      .chat-header {
        background: rgba(0, 0, 0, 0.4);
        padding: 1.25rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .ai-status {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .status-indicator {
        width: 10px;
        height: 10px;
        background-color: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
      }

      .ai-title {
        font-weight: 700;
        font-size: 1rem;
      }

      .model-tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        padding: 0.15rem 0.5rem;
        border-radius: 6px;
      }

      .chat-badge {
        font-size: 0.75rem;
        color: var(--prod-color);
        background: rgba(16, 185, 129, 0.15);
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        font-weight: 600;
      }

      .chat-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-height: 340px;
        overflow-y: auto;
      }

      .message-wrapper {
        display: flex;
        width: 100%;
      }

      .user-msg {
        justify-content: flex-end;
      }

      .ai-msg {
        justify-content: flex-start;
      }

      .message-bubble {
        max-width: 80%;
        padding: 0.85rem 1.15rem;
        border-radius: 14px;
        font-size: 0.925rem;
        line-height: 1.5;
        position: relative;
      }

      .user-msg .message-bubble {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: #ffffff;
        border-bottom-right-radius: 4px;
      }

      .ai-msg .message-bubble {
        background: rgba(30, 41, 59, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #f1f5f9;
        border-bottom-left-radius: 4px;
      }

      .msg-sender {
        font-size: 0.75rem;
        font-weight: 700;
        opacity: 0.8;
        margin-bottom: 0.25rem;
      }

      .msg-time {
        font-size: 0.675rem;
        opacity: 0.6;
        text-align: right;
        margin-top: 0.35rem;
      }

      .chat-footer {
        padding: 1rem 1.5rem;
        background: rgba(0, 0, 0, 0.3);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        gap: 0.75rem;
      }

      .chat-input {
        flex: 1;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        outline: none;
      }

      .send-btn {
        background: linear-gradient(135deg, #3b82f6, #10b981);
        border: none;
        color: #ffffff;
        padding: 0.75rem 1.25rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: opacity 0.2s ease;
      }

      .send-btn:hover {
        opacity: 0.9;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
      }

      .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 1.75rem;
        backdrop-filter: blur(12px);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.2);
      }

      .card.highlight-prod {
        border-color: rgba(16, 185, 129, 0.4);
        box-shadow: 0 8px 32px rgba(16, 185, 129, 0.12);
      }

      .card-icon {
        font-size: 2rem;
        margin-bottom: 1rem;
      }

      h2 {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        font-size: 0.9rem;
      }

      .info-row:last-child {
        border-bottom: none;
      }

      .label {
        color: var(--text-dim);
      }

      .badge-prod {
        background: rgba(16, 185, 129, 0.15);
        color: var(--prod-color);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.8rem;
      }

      .code {
        font-family: var(--font-mono);
        background: rgba(0, 0, 0, 0.4);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.85rem;
        color: #f1f5f9;
      }

      .steps {
        padding-left: 1.25rem;
        color: var(--text-dim);
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .steps li {
        margin-bottom: 0.75rem;
      }

      .steps code {
        font-family: var(--font-mono);
        color: var(--accent);
        background: rgba(0, 0, 0, 0.3);
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        font-size: 0.825rem;
      }

      .config-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .config-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.875rem;
      }

      .config-name {
        color: var(--text-dim);
      }

      .config-val code {
        font-family: var(--font-mono);
        background: rgba(0, 0, 0, 0.3);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        color: #38bdf8;
      }

      .footer {
        text-align: center;
        color: var(--text-dim);
        font-size: 0.875rem;
        border-top: 1px solid var(--card-border);
        padding-top: 2rem;
      }
    </style>
  </body>
</html>
