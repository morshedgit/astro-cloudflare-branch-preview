---
const branchName = "feature/analytics-dashboard";
const buildTime = new Date().toISOString();
const metrics = [
  { label: "Preview Latency", value: "24ms", status: "Optimal", color: "#10b981" },
  { label: "Edge Locations", value: "310+", status: "Active", color: "#38bdf8" },
  { label: "Cache Hit Ratio", value: "99.4%", status: "Global", color: "#a855f7" },
  { label: "Branch Commits", value: "12", status: "Synced", color: "#f97316" }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astro Cloudflare Branch Preview | {branchName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="background-glow"></div>
    <main class="container">
      <header class="header">
        <div class="badge preview-badge">
          <span class="pulse-dot"></span>
          <span>New Feature Branch: <strong>{branchName}</strong></span>
        </div>
        <h1>📊 Analytics Dashboard Feature</h1>
        <p class="subtitle">
          Testing Cloudflare Pages automatic branch preview generation for <code>feature/analytics-dashboard</code>.
        </p>
      </header>

      <!-- FEATURE HIGHLIGHT: Analytics Cards Grid -->
      <section class="metrics-section">
        <h2 class="section-title">✨ Branch Metrics & Performance (New Feature)</h2>
        <div class="metrics-grid">
          {metrics.map(m => (
            <div class="metric-card">
              <div class="metric-header">
                <span class="metric-label">{m.label}</span>
                <span class="metric-status" style={`background: ${m.color}20; color: ${m.color}; border: 1px solid ${m.color}40`}>
                  {m.status}
                </span>
              </div>
              <div class="metric-value">{m.value}</div>
            </div>
          ))}
        </div>
      </section>

      <div class="grid">
        <!-- Card 1: Branch Status -->
        <div class="card highlight-preview">
          <div class="card-icon">⚡</div>
          <h2>Branch Preview Status</h2>
          <div class="info-row">
            <span class="label">Environment:</span>
            <span class="value badge-preview">Per-Branch Preview</span>
          </div>
          <div class="info-row">
            <span class="label">Git Branch:</span>
            <code class="code">{branchName}</code>
          </div>
          <div class="info-row">
            <span class="label">Last Built:</span>
            <span class="value">{buildTime}</span>
          </div>
        </div>

        <!-- Card 2: Workflow Instructions -->
        <div class="card">
          <div class="card-icon">🧪</div>
          <h2>Branch Preview Verification</h2>
          <ol class="steps">
            <li>Cloudflare detects push to <code>{branchName}</code>.</li>
            <li>Generates unique URL: <code>https://feature-analytics-dashboard.astro-cloudflare-branch-preview.pages.dev</code></li>
            <li>Compare this preview URL against the <code>main</code> branch deployment!</li>
          </ol>
        </div>

        <!-- Card 3: Cloudflare Settings -->
        <div class="card">
          <div class="card-icon">⚙️</div>
          <h2>Cloudflare Pages Config</h2>
          <div class="config-list">
            <div class="config-item">
              <span class="config-name">Framework Preset:</span>
              <span class="config-val">Astro</span>
            </div>
            <div class="config-item">
              <span class="config-name">Build Command:</span>
              <span class="config-val"><code>npm run build</code></span>
            </div>
            <div class="config-item">
              <span class="config-name">Output Directory:</span>
              <span class="config-val"><code>dist</code></span>
            </div>
            <div class="config-item">
              <span class="config-name">Preview Deployment:</span>
              <span class="config-val">Automatic</span>
            </div>
          </div>
        </div>
      </div>

      <footer class="footer">
        <p>Built with ❤️ for testing GitHub & Cloudflare Pages Branch Previews</p>
      </footer>
    </main>

    <style>
      :root {
        --bg: #0b0f19;
        --card-bg: rgba(22, 30, 46, 0.75);
        --card-border: rgba(255, 255, 255, 0.08);
        --text: #e2e8f0;
        --text-dim: #94a3b8;
        --accent: #10b981;
        --accent-glow: rgba(16, 185, 129, 0.25);
        --preview-color: #38bdf8;
        --font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow-x: hidden;
      }

      .background-glow {
        position: absolute;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, var(--accent-glow) 0%, rgba(11, 15, 25, 0) 70%);
        top: -200px;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: none;
        z-index: 0;
      }

      .container {
        max-width: 980px;
        width: 100%;
        padding: 3rem 1.5rem;
        position: relative;
        z-index: 1;
      }

      .header {
        text-align: center;
        margin-bottom: 3rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: var(--accent);
        padding: 0.4rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
      }

      .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: var(--accent);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--accent);
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      h1 {
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #ffffff 30%, #34d399 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 1rem;
      }

      .subtitle {
        color: var(--text-dim);
        font-size: 1.125rem;
        max-width: 620px;
        margin: 0 auto;
        line-height: 1.6;
      }

      /* METRICS SECTION */
      .metrics-section {
        margin-bottom: 2.5rem;
      }

      .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
      }

      .metric-card {
        background: rgba(16, 185, 129, 0.05);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 12px;
        padding: 1.25rem;
        backdrop-filter: blur(8px);
      }

      .metric-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
      }

      .metric-label {
        font-size: 0.85rem;
        color: var(--text-dim);
      }

      .metric-status {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        text-transform: uppercase;
      }

      .metric-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: #ffffff;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
      }

      .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 1.75rem;
        backdrop-filter: blur(12px);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.2);
      }

      .card.highlight-preview {
        border-color: rgba(16, 185, 129, 0.4);
        box-shadow: 0 8px 32px rgba(16, 185, 129, 0.12);
      }

      .card-icon {
        font-size: 2rem;
        margin-bottom: 1rem;
      }

      h2 {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        font-size: 0.9rem;
      }

      .info-row:last-child {
        border-bottom: none;
      }

      .label {
        color: var(--text-dim);
      }

      .badge-preview {
        background: rgba(56, 189, 248, 0.15);
        color: var(--preview-color);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.8rem;
      }

      .code {
        font-family: var(--font-mono);
        background: rgba(0, 0, 0, 0.4);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.85rem;
        color: #f1f5f9;
      }

      .steps {
        padding-left: 1.25rem;
        color: var(--text-dim);
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .steps li {
        margin-bottom: 0.75rem;
      }

      .steps code {
        font-family: var(--font-mono);
        color: var(--accent);
        background: rgba(0, 0, 0, 0.3);
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        font-size: 0.825rem;
      }

      .config-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .config-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.875rem;
      }

      .config-name {
        color: var(--text-dim);
      }

      .config-val code {
        font-family: var(--font-mono);
        background: rgba(0, 0, 0, 0.3);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        color: #38bdf8;
      }

      .footer {
        text-align: center;
        color: var(--text-dim);
        font-size: 0.875rem;
        border-top: 1px solid var(--card-border);
        padding-top: 2rem;
      }
    </style>
  </body>
</html>
