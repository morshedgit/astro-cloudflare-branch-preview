---
import StudioDrawer from '../components/StudioDrawer.astro';

const branchName = "feature/studio-editor";
const buildTime = new Date().toISOString();

const metrics = [
  { label: "Production Latency", value: "14ms", status: "Optimal", color: "#10b981" },
  { label: "Edge Locations", value: "320+", status: "Active", color: "#38bdf8" },
  { label: "Studio Mode", value: "?studio=true", status: "QueryParam", color: "#a855f7" },
  { label: "Branch Previews", value: "Enabled", status: "Automatic", color: "#f97316" }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astro Cloudflare Studio | {branchName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="background-glow"></div>
    <main class="container">
      <header class="header">
        <div class="badge studio-badge">
          <span class="pulse-dot"></span>
          <span>Studio Feature: <strong>?studio=true</strong> Enabled</span>
        </div>
        <h1>🎨 Universal Studio Editor</h1>
        <p class="subtitle">
          Append <code>?studio=true</code> to any page URL to open the live Studio drawer, edit design tokens & page copy, and push a new branch to Cloudflare Pages!
        </p>

        <!-- CTA TO TRIGGER STUDIO VIA QUERYPARAM -->
        <div class="header-actions">
          <a href="/?studio=true" class="cta-studio-btn">
            <span>✨ Enable Studio Overlay (?studio=true)</span>
          </a>
        </div>
      </header>

      <!-- METRICS GRID -->
      <section class="metrics-section">
        <h2 class="section-title">📊 Platform Metrics</h2>
        <div class="metrics-grid">
          {metrics.map(m => (
            <div class="metric-card">
              <div class="metric-header">
                <span class="metric-label">{m.label}</span>
                <span class="metric-status" style={`background: ${m.color}20; color: ${m.color}; border: 1px solid ${m.color}40`}>
                  {m.status}
                </span>
              </div>
              <div class="metric-value">{m.value}</div>
            </div>
          ))}
        </div>
      </section>

      <div class="grid">
        <!-- Card 1: QueryParam Studio Feature -->
        <div class="card highlight-studio">
          <div class="card-icon">🛠️</div>
          <h2>QueryParam Studio Features</h2>
          <div class="info-row">
            <span class="label">Universal URL Trigger:</span>
            <code class="code">?studio=true</code>
          </div>
          <div class="info-row">
            <span class="label">Live Token Editor:</span>
            <span class="value">DOM Content & CSS Tokens</span>
          </div>
          <div class="info-row">
            <span class="label">Branch Exporter:</span>
            <span class="value">Pushes <code>studio/*</code> branches</span>
          </div>
        </div>

        <!-- Card 2: Workflow Summary -->
        <div class="card">
          <div class="card-icon">⚡</div>
          <h2>How to Use Studio</h2>
          <ol class="steps">
            <li>Visit <code>/?studio=true</code> on any page.</li>
            <li>Click the floating <strong>Studio Active 🎨</strong> badge at the bottom right.</li>
            <li>Edit content, tweak colors, and click <strong>Commit & Push Branch</strong>!</li>
          </ol>
        </div>
      </div>

      <footer class="footer">
        <p>Built with ❤️ for testing GitHub & Cloudflare Pages Branch Previews</p>
      </footer>
    </main>

    <!-- UNIVERSAL STUDIO DRAWER OVERLAY -->
    <StudioDrawer />

    <style>
      :root {
        --bg: #090d16;
        --card-bg: rgba(22, 30, 46, 0.75);
        --card-border: rgba(255, 255, 255, 0.08);
        --text: #e2e8f0;
        --text-dim: #94a3b8;
        --accent: #a855f7;
        --accent-glow: rgba(168, 85, 247, 0.25);
        --font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow-x: hidden;
      }

      .background-glow {
        position: absolute;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, var(--accent-glow) 0%, rgba(9, 13, 22, 0) 70%);
        top: -200px;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: none;
        z-index: 0;
      }

      .container {
        max-width: 960px;
        width: 100%;
        padding: 3rem 1.5rem;
        position: relative;
        z-index: 1;
      }

      .header {
        text-align: center;
        margin-bottom: 3rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(168, 85, 247, 0.12);
        border: 1px solid rgba(168, 85, 247, 0.3);
        color: var(--accent);
        padding: 0.4rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
      }

      .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: var(--accent);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--accent);
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      h1 {
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #ffffff 30%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 1rem;
      }

      .subtitle {
        color: var(--text-dim);
        font-size: 1.125rem;
        max-width: 640px;
        margin: 0 auto 2rem auto;
        line-height: 1.6;
      }

      .header-actions {
        display: flex;
        justify-content: center;
      }

      .cta-studio-btn {
        background: linear-gradient(135deg, #a855f7, #ec4899);
        color: #ffffff;
        text-decoration: none;
        padding: 0.85rem 2rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        box-shadow: 0 8px 24px rgba(168, 85, 247, 0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .cta-studio-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(168, 85, 247, 0.45);
      }

      .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .metrics-section {
        margin-bottom: 3rem;
      }

      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
      }

      .metric-card {
        background: rgba(168, 85, 247, 0.05);
        border: 1px solid rgba(168, 85, 247, 0.2);
        border-radius: 12px;
        padding: 1.25rem;
        backdrop-filter: blur(8px);
      }

      .metric-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
      }

      .metric-label {
        font-size: 0.85rem;
        color: var(--text-dim);
      }

      .metric-status {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        text-transform: uppercase;
      }

      .metric-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: #ffffff;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
      }

      .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 1.75rem;
        backdrop-filter: blur(12px);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.2);
      }

      .card.highlight-studio {
        border-color: rgba(168, 85, 247, 0.4);
        box-shadow: 0 8px 32px rgba(168, 85, 247, 0.12);
      }

      .card-icon {
        font-size: 2rem;
        margin-bottom: 1rem;
      }

      h2 {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        font-size: 0.9rem;
      }

      .info-row:last-child {
        border-bottom: none;
      }

      .label {
        color: var(--text-dim);
      }

      .code {
        font-family: var(--font-mono);
        background: rgba(0, 0, 0, 0.4);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.85rem;
        color: #f1f5f9;
      }

      .steps {
        padding-left: 1.25rem;
        color: var(--text-dim);
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .steps li {
        margin-bottom: 0.75rem;
      }

      .footer {
        text-align: center;
        color: var(--text-dim);
        font-size: 0.875rem;
        border-top: 1px solid var(--card-border);
        padding-top: 2rem;
      }
    </style>
  </body>
</html>
